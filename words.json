      "at": [170, 120],
      "from": "talk-1",
      "aliens": [
        {
          "name": "Mox",
          "shape": "hood",
          "colours": ["#8a5a3a", "#5a3a22", "#ffe81f"],
          "lines": [
            { "pip": "Hello! We are on a quest.", "say": ["I have a map for you.", "I have a mop for you.", "I have a map for him."] },
            { "pip": "A map! What is on it?", "say": ["A red cross on a hill.", "A red cross on a mill.", "A red dress on a hill."] },
            { "pip": "What is at the red cross?", "say": ["A big chest of gold.", "A big chest of sand.", "A big nest of gold."] },
            { "pip": "Thank you! How do we get there?", "say": ["Go left at the pond.", "Go left at the tent.", "Go up at the pond."] }
          ]
        },
        {
          "name": "Blobba",
          "shape": "slug",
          "colours": ["#b8c45a", "#7d8a32", "#ffe81f"],
          "lines": [
            { "pip": "Hello, boss! May we come in?", "say": ["Stop! This is my land.", "Stop! This is my hand.", "Stop! That is my land."] },
            { "pip": "Sorry! We just want a crystal.", "say": ["Then bring me a snack.", "Then bring me a sock.", "Then sing me a snack."] },
            { "pip": "Here is a plum.", "say": ["Yum! That was the best.", "Yum! That was the rest.", "Yuck! That was the best."] },
            { "pip": "So, may we have it?", "say": ["Yes. Grab it and go!", "Yes. Grab it and run!", "Yes. Drop it and go!"] }
          ]
        },
        {
          "name": "Tin",
          "shape": "guard",
          "colours": ["#f4f4f4", "#b9c0cf", "#3fa9ff"],
          "lines": [
            { "pip": "Hello! What is that in your hand?", "say": ["This is a strong rope.", "This is a strong robe.", "That is a strong rope."] },
            { "pip": "What is it for?", "say": ["It can lift big rocks.", "It can lift big socks.", "It can lift six rocks."] },
            { "pip": "Can we use it?", "say": ["Yes, but bring it back.", "Yes, but bring it here.", "No, but bring it back."] },
            { "pip": "Look! A crystal was under the rock!", "say": ["Well done! Keep it safe.", "Well done! Keep it here.", "Well done! Keep it soft."] }
          ]
        }
      ]
    },
    {
      "id": "talk-3",
      "name": "Longer chats",
      "planet": "Aurora",
      "env": "aurora",
      "at": [80, 195],
      "from": "talk-2",
      "aliens": [
        {
          "name": "Lanky",
          "shape": "tall",
          "colours": ["#9fe0d0", "#5fa898", "#ffe81f"],
          "lines": [
            { "pip": "Hello! What can you see up there?", "say": ["I can see the green moon.", "I can see the green tree.", "I can feel the green moon."] },
            { "pip": "Is it far away?", "say": ["Yes, it is a long trip.", "Yes, it is a long ship.", "No, it is a long trip."] },
            { "pip": "Have you ever been there?", "say": ["No, but I wish I had.", "No, but I wish I did.", "Yes, but I wish I had."] },
            { "pip": "Here, look in my telescope!", "say": ["Wow! I can see a ship!", "Wow! I can see a sheep!", "Wow! I can see a shop!"] }
          ]
        },
        {
          "name": "Squee",
          "shape": "squid",
          "colours": ["#ff8ab8", "#c04f80", "#ffe81f"],
          "lines": [
            { "pip": "Hello! Why are you all wet?", "say": ["I had a swim in the pool.", "I had a swim in the pond.", "I had a spin in the pool."] },
            { "pip": "Brr! Was it cold?", "say": ["Yes, it was full of ice.", "Yes, it was full of mice.", "No, it was full of ice."] },
            { "pip": "Do you need a towel?", "say": ["Yes please, I feel so cold.", "Yes please, I feel so old.", "No thanks, I feel so cold."] },
            { "pip": "Here you are. Is that better?", "say": ["Much better. This is for you!", "Much better. This is for me!", "Much wetter. This is for you!"] }
          ]
        },
        {
          "name": "Chirp",
          "shape": "robot",
          "colours": ["#f08a24", "#b85c12", "#6fe3ff"],
          "lines": [
            { "pip": "Hello! Are you all right?", "say": ["No, my left arm is stuck.", "No, my left leg is stuck.", "No, my best arm is stuck."] },
            { "pip": "Shall I fix it for you?", "say": ["Yes please, I need some oil.", "Yes please, I need some soil.", "Yes please, I need some foil."] },
            { "pip": "There! Can you move it now?", "say": ["Yes! Look at me wave!", "Yes! Look at me dive!", "Yes! Look at me save!"] },
            { "pip": "Hooray! You are fixed!", "say": ["Thank you. Take this with you.", "Thank you. Take this with me.", "Thank you. Bake this with you."] }
          ]
        }
      ]
