  "talk": [
    {
      "id": "talk-1",
      "name": "Little chats",
      "planet": "Blip",
      "env": "swamp",
      "at": [70, 85],
      "aliens": [
        {
          "name": "Zib",
          "shape": "blob",
          "colours": ["#5fd35f", "#2f8f3f", "#ffe81f"],
          "lines": [
            { "pip": "Hello! Can you help us?", "say": ["Yes, I can.", "Yes, I ran.", "Yes, I am."] },
            { "pip": "We are looking for a crystal.", "say": ["It is in a box.", "It is in a bag.", "It is on a box."] },
            { "pip": "Where is the box?", "say": ["Dig in the mud.", "Dig in the mug.", "Sit in the mud."] },
            { "pip": "I found it! But it is locked.", "say": ["Get the red key.", "Get the red cup.", "Get the big key."] }
          ]
        },
        {
          "name": "Bolt",
          "shape": "robot",
          "colours": ["#9aa4b5", "#5c6478", "#ffe81f"],
          "lines": [
            { "pip": "Hello, robot! What is that?", "say": ["It is my jet.", "It is my net.", "It is my pet."] },
            { "pip": "Wow! Can it go fast?", "say": ["Yes, it can zip.", "Yes, it can sip.", "Yes, it can hop."] },
            { "pip": "Can I have a go?", "say": ["Hop on the top.", "Hop on the mop.", "Sit on the top."] },
            { "pip": "Wheee! That was fun!", "say": ["A gift for you.", "A lift for you.", "A gift for me."] }
          ]
        },
        {
          "name": "Grum",
          "shape": "monster",
          "colours": ["#c77dff", "#8a4fc0", "#ffe81f"],
          "lines": [
            { "pip": "Hello! Can we get past?", "say": ["No, not yet.", "No, not wet.", "No, not you."] },
            { "pip": "Oh. What do you want?", "say": ["Jam on a bun.", "Jam on a bus.", "Ham on a bun."] },
            { "pip": "Here you are. Is it good?", "say": ["It is the best.", "It is the nest.", "It is the bus."] },
            { "pip": "Can we go past now?", "say": ["Yes, you can go.", "Yes, you can dig.", "No, you can go."] }
          ]
        }
      ]
    },
    {
      "id": "talk-2",
      "name": "Short chats",
      "planet": "Dusko",
